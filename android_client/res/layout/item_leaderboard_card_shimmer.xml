<?xml version="1.0" encoding="utf-8"?>
<!-- item_leaderboard_card_shimmer.xml -->
<!-- Grey Skeleton matching item_leaderboard_card.xml -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <View
            android:id="@+id/shimmerRank"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#E0E0E0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/shimmerUsername"
            android:layout_width="120dp"
            android:layout_height="20dp"
            android:layout_marginStart="24dp"
            android:background="#E0E0E0"
            app:layout_constraintBottom_toTopOf="@id/shimmerBranch"
            app:layout_constraintStart_toEndOf="@id/shimmerRank"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <View
            android:id="@+id/shimmerBranch"
            android:layout_width="80dp"
            android:layout_height="14dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:background="#E0E0E0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/shimmerRank"
            app:layout_constraintTop_toBottomOf="@id/shimmerUsername" />

        <View
            android:id="@+id/shimmerTotalCoins"
            android:layout_width="60dp"
            android:layout_height="20dp"
            android:background="#E0E0E0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>