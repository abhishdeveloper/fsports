# Bulletproof Shared Hosting Configuration
# Removed complex DirectoryMatch and FilesMatch rules that frequently cause
# 500 Internal Server Errors on strict HestiaCP/cPanel configurations if AllowOverride is disabled.

# Disable directory browsing globally
Options -Indexes

# ----------------------------------------------------------------------
# Clean URLs and Routing
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Optional: Force HTTPS
    # RewriteCond %{HTTPS} off
    # RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # If the request is not a file or directory, let the frontend handle it
    # RewriteCond %{REQUEST_FILENAME} !-f
    # RewriteCond %{REQUEST_FILENAME} !-d
    # RewriteRule ^(.*)$ index.html [L]
</IfModule>